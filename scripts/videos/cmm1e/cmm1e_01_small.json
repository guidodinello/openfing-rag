  },
  {
    "start": 1407.0,
    "end": 1409.0,
    "text": "en la polea C"
  },
  {
    "start": 1409.0,
    "end": 1411.0,
    "text": "como le decía, este desarrollo"
  },
  {
    "start": 1411.0,
    "end": 1413.0,
    "text": "que hemos hecho aquí rápidamente"
  },
  {
    "start": 1413.0,
