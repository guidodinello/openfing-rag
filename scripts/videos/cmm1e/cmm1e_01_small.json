  },
  {
    "start": 1381.0,
    "end": 1383.0,
    "text": "y 1318 N"
  },
  {
    "start": 1383.0,
    "end": 1385.0,
    "text": "y ahí finalmente"
  },
  {
    "start": 1385.0,
    "end": 1387.0,
    "text": "lo único que queda es"
  },
  {
    "start": 1387.0,
    "end": 1389.0,
    "text": "evaluar el valor del par"
  },
  {
    "start": 1391.0,
    "end": 1393.0,
    "text": "de salida de la polea C"
  },
  {
    "start": 1393.0,
    "end": 1395.0,
    "text": "y particular la velocidad"
  },
  {
    "start": 1395.0,
    "end": 1397.0,
    "text": "del giro de la polea C"
  },
  {
    "start": 1397.0,
