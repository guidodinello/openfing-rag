    "text": "a partir o bien de una relación geométrica"
  },
  {
    "start": 1399.0,
    "end": 1401.0,
    "text": "o bien de la igualdad"
  },
  {
    "start": 1401.0,
    "end": 1403.0,
    "text": "de potencias suministradas"
  },
  {
    "start": 1403.0,
    "end": 1405.0,
    "text": "en la polea A"
  },
  {
    "start": 1405.0,
    "end": 1407.0,
