  {
    "start": 1325.0,
    "end": 1327.0,
    "text": "para el contacto a puntos de deslizamiento"
  },
  {
    "start": 1327.0,
    "end": 1329.0,
    "text": "entre la cinta y la polea"
  },
  {
    "start": 1329.0,
    "end": 1331.0,
    "text": "B de radio"
  },
  {
    "start": 1331.0,
    "end": 1333.0,
    "text": "B1"
  },
  {
    "start": 1333.0,
    "end": 1335.0,
    "text": "y esa relación de fricción"
  },
  {
    "start": 1335.0,
    "end": 1337.0,
    "text": "da un consciente"
  },
  {
    "start": 1337.0,
    "end": 1339.0,
    "text": "entre las tensiones"
  },
  {
    "start": 1339.0,
    "end": 1341.0,
    "text": "de esta banda"
  },
  {
    "start": 1341.0,
    "end": 1343.0,
    "text": "de T2 prima"
