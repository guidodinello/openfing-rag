  },
  {
    "start": 1357.0,
    "end": 1359.0,
    "text": "T2 menos T1"
  },
  {
    "start": 1359.0,
    "end": 1361.0,
    "text": "que tenemos una ecuación para T2 prima"
  },
  {
    "start": 1361.0,
    "end": 1363.0,
    "text": "menos T1 prima"
  },
  {
    "start": 1363.0,
    "end": 1365.0,
    "text": "si la juntamos con esta otra ecuación"
  },
  {
    "start": 1365.0,
    "end": 1367.0,
