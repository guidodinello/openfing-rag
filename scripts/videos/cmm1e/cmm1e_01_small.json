  {
    "start": 1343.0,
    "end": 1345.0,
    "text": "sobre T1 prima"
  },
  {
    "start": 1345.0,
    "end": 1347.0,
    "text": "igual a 2,43"
  },
  {
    "start": 1351.0,
    "end": 1353.0,
    "text": "como ya tenemos nuevamente"
  },
  {
    "start": 1353.0,
    "end": 1355.0,
    "text": "esta relación"
  },
  {
    "start": 1355.0,
    "end": 1357.0,
