## Shared cache/output directory used by Whisper, Embeddings, Downloader, and Transcriber.
## Must point to an existing directory on your machine.
TMP_CACHE_DIR=

##  App Settings

APP__ENV="local"
APP__NAME="Educational RAG [DEV]"
APP__VERSION="v1.0.0-dev"

## SSL/Domain Settings (production only — not needed for local development)

DOMAIN_NAME=                            # e.g. myapp.com
SSL_EMAIL=                              # e.g. admin@myapp.com — used for Let's Encrypt certificate registration

VITE_API_URL="/api/v1"
VITE_APP_TITLE="OpenChat"
VITE_APP_VERSION="${APP__VERSION}"

DOCS_URL="/docs"
REDOC_URL="/redoc"
OPENAPI_URL="/openapi.json"
HEALTH_URL="/health"

API_URL="/api"
FRONTEND_URL="http://localhost:5173"

NEVER_SKIP_RETRIEVAL=false              # If true, always retrieves docs even for follow-up questions (increases latency)

SENTRY__DSN=""

VITE_SENTRY_DSN="${SENTRY__DSN}"
VITE_SENTRY_ORG=""
VITE_SENTRY_PROJECT=""

## Server Settings
SERVER__HOST="0.0.0.0"
SERVER__PORT="8000"
SERVER__WORKERS_COUNT=1

## Logger Settings
LOG__LEVEL="DEBUG"
LOG__DIR="logs/"

## Database Settings
DATABASE__USER="psql_usr"
DATABASE__PASSWORD="psql_pass"          # Change this
DATABASE__DB="psql_db"
DATABASE__HOST="127.0.0.1"             # Use "database" when running with docker-compose
DATABASE__PORT=5432
DATABASE__VECTOR_STORE_COLLECTION="chunks"
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=10

## Models Configuration
WHISPER__MODEL="tiny"
WHISPER__CACHE_DIR="${TMP_CACHE_DIR}"
WHISPER__DEVICE="auto"

EMBEDDINGS__MODEL="intfloat/multilingual-e5-base"
EMBEDDINGS__DIMENSION=768
# EMBEDDINGS__MODEL="sentence-transformers/all-MiniLM-L6-v2"
# EMBEDDINGS__DIMENSION=384
EMBEDDINGS__CACHE_DIR="${WHISPER__CACHE_DIR}"
EMBEDDINGS__DEVICE="auto"

## SERVICES

# Prompts
PROMPTS__BASE_DIR="./shared/prompts"
PROMPTS__GENERATOR_TEMPLATE="educational_assistant"
PROMPTS__TRANSCRIBER_TEMPLATE="educational_transcription"

# Downloader
DOWNLOADER__OUTPUT_DIR="${TMP_CACHE_DIR}"
DOWNLOADER__WORKERS=5
DOWNLOADER__CODEC="best"
DOWNLOADER__QUALITY="0"

# Transcriber
TRANSCRIBER__INPUT_DIR="${DOWNLOADER__OUTPUT_DIR}"
TRANSCRIBER__OUTPUT_DIR="${TMP_CACHE_DIR}"

# Scraper
SCRAPER__WORKERS=5
SCRAPER__OPENFING_URL="https://open.fing.edu.uy"

## External Services
PREFECT__DB="${DATABASE__DB}"
PREFECT__API_URL="http://127.0.0.1:4200/api"  # Use "http://prefect:4200/api" when running with docker-compose

# LLM Provider
LLM__PROVIDER="huggingface"

LLM__OLLAMA__BASE_URL="http://localhost:11434"
LLM__OLLAMA__MODEL="gemma3:1b-it-qat"

LLM__HUGGINGFACE__API_KEY=""            # Get from huggingface.co/settings/tokens
LLM__HUGGINGFACE__MODEL="meta-llama/Meta-Llama-3.1-8B-Instruct"
# "Qwen/Qwen2.5-72B-Instruct"          COSTLY
# "mistralai/Mistral-7B-Instruct-v0.3" DEPRECATED

LANGSMITH__API_KEY=""                   # Optional: get from smith.langchain.com
LANGSMITH__TRACING=false

## Security
# Generate with: openchat secrets generate-jwt-secret
JWT__SECRET_KEY=
JWT__ALGORITHM="HS256"
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT__REFRESH_TOKEN_EXPIRE_DAYS=7
JWT__TOKEN_URL="/login"

# Generate with: openchat secrets generate-hmac-secret
API_KEYS__HMAC_SECRET=
