# Ignore node_modules (Docker will handle this during the build)
node_modules/

# Ignore build or dist folders (not needed in Docker)
build/
dist/

# Ignore git-related files and folders
.git/

# Ignore environment files
*.env

# Ignore log files
*.l
# Ignore temporary files
/tmp/

# Ignore the Dockerfile itself (unless you have multiple Dockerfiles)
Dockerfile

# Optionally: Ignore package-lock.json if you don’t want to copy it (but generally recommended to copy for consistency)
#package-lock.json
