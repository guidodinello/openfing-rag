##  App Settings
DEBUG=true

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS_COUNT=5
FRONTEND_URL="http://localhost:3000"

# Logger Settings
LOG_LEVEL="DEBUG"
LOG_DIR="logs/"

## SERVICES

# Downloader Settings
DOWNLOADER_OUTPUT_DIR="./audios"
DOWNLOADER_WORKERS=5
DOWNLOADER_CODEC="best"
DOWNLOADER_QUALITY="0"

# Transcriber Settings
TRANSCRIBER_PORT=8001
TRANSCRIBER_INPUT_DIR="${DOWNLOADER_OUTPUT_DIR}" # Should match so the transcriber finds the downloaded audio files
TRANSCRIBER_OUTPUT_DIR="./transcriptions"

# Scraper Settings
SCRAPER_WORKERS=5
SCRAPER_OPENFING_URL="https://open.fing.edu.uy"

## SHARED

# Database Settings
DATABASE_USER="psql_usr"
DATABASE_PASSWORD="psql_pass"
DATABASE_DB="psql_db"
DATABASE_HOST="localhost"
DATABASE_PORT=5432

DATABASE_VECTOR_STORE_COLLECTION="chunks"

## Models
WHISPER_MODEL="tiny"
WHISPER_CACHE_DIR="models_cache"

EMBEDDINGS_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDINGS_DIMENSION=384
EMBEDDINGS_CACHE_DIR="${WHISPER_CACHE_DIR}"

## External Services
PREFECT_DB="${DATABASE_DB}"
PREFECT_API_KEY=""

HUGGINGFACE_API_KEY=""

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=""
