# Database configuration
DATABASE_URL=postgresql+psycopg2://username:password@127.0.0.1:5432/database_name
username=postgres
password=postgres
host=127.0.0.1
port=5432
database_name=postgres

# Replace the placeholders with your actual values:
# - `username`: The username for your PostgreSQL database.
# - `password`: The password for your PostgreSQL database.
# - `127.0.0.1`: The host where your PostgreSQL server is running (use `localhost` or the IP address of the server).
# - `5432`: The port on which your PostgreSQL server is listening (default is 5432).
# - `database_name`: The name of the database you want to connect to.