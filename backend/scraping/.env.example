# Environment settings
ENVIRONMENT=development
DEBUG=false

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS_COUNT=1

# Security settings
SECRET_KEY=your-secret-key-for-dev
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS settings
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# Vector store settings
VECTOR_STORE_COLLECTION=rag_chunks

# External services
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Prefect settings
PREFECT_API_URL=http://127.0.0.1:4200/api

# Database settings (with prefix)
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=openfing_chat
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_DB_PREFECT=prefect

# Logging settings (with prefix)
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FILE_PATH=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_BACKUP_COUNT=5

# Whisper settings (with prefix)
WHISPER_MODEL=tiny

# Embeddings settings (with prefix)
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDINGS_DIMENSION=384
EMBEDDINGS_CACHE_DIR=
EMBEDDINGS_BATCH_SIZE=32